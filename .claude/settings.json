{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "theme": "dark-daltonized",
  "tui": "fullscreen",

  "autoUpdatesChannel": "stable",
  "alwaysThinkingEnabled": true,
  "fallbackModel": ["claude-sonnet-5"],

  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest run:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo expand:*)",
      "Bash(rustc --version)",
      "Bash(rustup show)",
      "Bash(rustup toolchain list)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git stash list)",

      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl config get-contexts)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",

      "Grep",
      "Glob",

      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:rust-lang.org)",
      "WebFetch(domain:*.rust-lang.org)",
      "WebFetch(domain:rust-lang.github.io)",

      "WebFetch(domain:go.dev)",
      "WebFetch(domain:*.go.dev)",
      "WebFetch(domain:golang.org)",
      "WebFetch(domain:*.golang.org)",

      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:*.kubernetes.io)",
      "WebFetch(domain:k8s.io)",
      "WebFetch(domain:kubernetes-sigs.github.io)",
      "WebFetch(domain:kubernetes.github.io)",

      "WebFetch(domain:helm.sh)",
      "WebFetch(domain:*.helm.sh)",
      "WebFetch(domain:artifacthub.io)",
      "WebFetch(domain:helmfile.org)",
      "WebFetch(domain:helmfile.readthedocs.io)",

      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:awscli.amazonaws.com)",

      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:googleapis.dev)",

      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:opentofu.org)",

      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(cargo add:*)",
      "Bash(cargo remove:*)",
      "Bash(cargo update:*)",
      "Bash(terraform:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(helm:*)",
      "Bash(helmfile:*)"
    ],

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.cargo/credentials.toml)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",

      "Bash(sudo:*)",
      "Bash(rm -rf:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",

      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",

      "Bash(cargo publish:*)",
      "Bash(cargo login:*)",

      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible-pull:*)",
      "Bash(ansible-console:*)",
      "Bash(ansible-vault:*)",
      "Bash(ansible-galaxy install:*)",

      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl create token:*)",

      "Bash(helmfile apply:*)",
      "Bash(helmfile sync:*)",
      "Bash(helmfile destroy:*)",
      "Bash(helmfile delete:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm install:*)",
      "Bash(helm rollback:*)",

      "Bash(aws iam:*)",
      "Bash(aws kms:*)",
      "Bash(aws sts:*)",
      "Bash(aws configure:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 sync:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(aws rds delete-db-instance:*)",
      "Bash(aws ecr get-login-password:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws ssm get-parameter:*)",

      "Bash(gcloud auth:*)",
      "Bash(gcloud iam:*)",
      "Bash(gcloud projects delete:*)",
      "Bash(gcloud secrets versions access:*)",
      "Bash(gcloud compute instances delete:*)",
      "Bash(gcloud container clusters delete:*)",
      "Bash(gcloud sql instances delete:*)",
      "Bash(gsutil rm:*)",
      "Bash(gsutil rb:*)",

      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ]
  }
}
